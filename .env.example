# LLM Configuration
LLM_PROVIDER=gemini       # Options: gemini, groq, mock, openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-1.5-flash

# Backend Configuration
DATABASE_URL=sqlite:///./resume_screener.db
API_HOST=0.0.0.0
API_PORT=8000

# Screening Defaults
DEFAULT_RULE_WEIGHT=0.3
DEFAULT_SEMANTIC_WEIGHT=0.4
DEFAULT_EXPERIENCE_WEIGHT=0.2
DEFAULT_LLM_FIT_WEIGHT=0.1
